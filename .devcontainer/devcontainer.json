{
  "name": "trading-bot",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "postCreateCommand": "pip install -r requirements.txt && ([ -f .env ] || cp .env.example .env)",
  // Every start/resume of the Codespace: start the bot, make port 8000 public, print connect info.
  "postStartCommand": "bash scripts/codespace.sh start",
  "forwardPorts": [8000],
  "portsAttributes": { "8000": { "label": "Trading bot", "onAutoForward": "silent" } },
  "containerEnv": {
    "HOST": "0.0.0.0",
    "AUTO_GIT_PUSH": "true"
  },
  "secrets": {
    "DASHBOARD_TOKEN": { "description": "Access token for the terminal and /mcp. Leave unset to auto-generate one." },
    "LLM_API_KEY": { "description": "Optional: API key for the bot's built-in AI (xAI, OpenAI, OpenRouter…)" },
    "LLM_BASE_URL": { "description": "Optional: e.g. https://api.x.ai/v1" },
    "LLM_MODEL": { "description": "Optional: e.g. grok-4" },
    "ALPACA_API_KEY": { "description": "Optional: Alpaca key" },
    "ALPACA_API_SECRET": { "description": "Optional: Alpaca secret" }
  }
}
