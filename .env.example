# ---------- Broker ----------
# paper_sim  = fully offline simulated market + simulated fills (default, no keys needed)
# alpaca     = Alpaca account (paper or live depending on ALPACA_LIVE)
BROKER=paper_sim
ALPACA_API_KEY=
ALPACA_API_SECRET=
# Real money only when BOTH of these are set exactly like this:
ALPACA_LIVE=false
LIVE_TRADING_CONFIRM=            # must equal: I_ACCEPT_REAL_MONEY_RISK

SYMBOLS=SPY,QQQ,AAPL,MSFT,NVDA
BAR_TIMEFRAME=5Min
TICK_SECONDS=60                  # how often the engine wakes up (paper_sim: 1 tick = 1 bar)

# ---------- Built-in AI brain: ANY OpenAI-compatible chat API ----------
# xAI Grok:    LLM_BASE_URL=https://api.x.ai/v1           LLM_MODEL=grok-4
# OpenAI:      LLM_BASE_URL=https://api.openai.com/v1     LLM_MODEL=<openai model id>
# OpenRouter:  LLM_BASE_URL=https://openrouter.ai/api/v1  LLM_MODEL=<provider/model>  (hundreds of models)
# Ollama:      LLM_BASE_URL=http://localhost:11434/v1     LLM_MODEL=<local model>  LLM_API_KEY=ollama
# (XAI_API_KEY / GROK_MODEL / XAI_BASE_URL still work as aliases.)
LLM_API_KEY=
LLM_BASE_URL=https://api.x.ai/v1
LLM_MODEL=grok-4

# ---------- Bot as an MCP SERVER (any AI tool connects TO the bot) ----------
# Served at http(s)://<bot>/mcp, protected by DASHBOARD_TOKEN. Claude, ChatGPT, Cursor, Grok… can then
# read status, pause/flatten, backtest and submit strategies (same safety gate as the built-in AI).
MCP_SERVER_ENABLED=true

# ---------- Bot as an MCP CLIENT (the built-in AI uses another MCP server's tools, e.g. "grokbot") ----------
# Either a streamable-HTTP URL...
MCP_SERVER_URL=
MCP_SERVER_TOKEN=
# ...or a stdio command, e.g. "npx -y some-mcp-server"
MCP_SERVER_COMMAND=

# ---------- Self-improvement ----------
EVOLVE_EVERY_TICKS=120           # 0 disables automatic evolution
EVOLVE_MIN_IMPROVEMENT=0.05      # candidate must beat incumbent's holdout score by this much
AUTO_GIT_COMMIT=true             # commit each promoted strategy version to git

# ---------- Hard risk limits (the AI cannot change these) ----------
MAX_POSITION_PCT=0.20            # max 20% of equity in any one symbol
MAX_GROSS_EXPOSURE=1.0           # no leverage
MAX_ORDER_NOTIONAL=5000
MAX_DAILY_LOSS_PCT=0.03          # kill switch: flatten + halt at -3% on the day
ALLOW_SHORT=false
MAX_MANUAL_ORDERS_PER_HOUR=30     # cap on direct (desk) orders from an AI or you; closing is exempt

# ---------- Dashboard ----------
HOST=127.0.0.1
PORT=8000
# Access token for the terminal AND the /mcp endpoint. Required if HOST is not localhost.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(24))"
DASHBOARD_TOKEN=
