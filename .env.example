# ---------- Broker ----------
# paper_sim  = fully offline simulated market + simulated fills (default, no keys needed)
# alpaca     = Alpaca account (paper or live depending on ALPACA_LIVE)
BROKER=paper_sim
ALPACA_API_KEY=
ALPACA_API_SECRET=
# Real money only when BOTH of these are set exactly like this:
ALPACA_LIVE=false
LIVE_TRADING_CONFIRM=            # must equal: I_ACCEPT_REAL_MONEY_RISK

SYMBOLS=SPY,QQQ,AAPL,MSFT,NVDA
BAR_TIMEFRAME=5Min
TICK_SECONDS=60                  # how often the engine wakes up (paper_sim: 1 tick = 1 bar)

# ---------- AI brain (xAI Grok, OpenAI-compatible API) ----------
XAI_API_KEY=
GROK_MODEL=grok-4
XAI_BASE_URL=https://api.x.ai/v1

# ---------- MCP ("grokbot" or any MCP server) ----------
# Either a streamable-HTTP URL...
MCP_SERVER_URL=
MCP_SERVER_TOKEN=
# ...or a stdio command, e.g. "npx -y some-mcp-server"
MCP_SERVER_COMMAND=

# ---------- Self-improvement ----------
EVOLVE_EVERY_TICKS=120           # 0 disables automatic evolution
EVOLVE_MIN_IMPROVEMENT=0.05      # candidate must beat incumbent's holdout score by this much
AUTO_GIT_COMMIT=true             # commit each promoted strategy version to git

# ---------- Hard risk limits (the AI cannot change these) ----------
MAX_POSITION_PCT=0.20            # max 20% of equity in any one symbol
MAX_GROSS_EXPOSURE=1.0           # no leverage
MAX_ORDER_NOTIONAL=5000
MAX_DAILY_LOSS_PCT=0.03          # kill switch: flatten + halt at -3% on the day
ALLOW_SHORT=false

# ---------- Dashboard ----------
HOST=127.0.0.1
PORT=8000
DASHBOARD_TOKEN=                 # required if HOST is not localhost
